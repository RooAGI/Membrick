{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "description": "Local search on your context and project files, exposed via MCP. One memory for every agent.",
    "name": "io.github.RooAGI/membrick",
    "packages": [
        {
            "identifier": "membrick",
            "registryType": "cargo",
            "runtimeArguments": [
                {
                    "type": "positional",
                    "value": "serve"
                },
                {
                    "type": "positional",
                    "value": "claude"
                }
            ],
            "transport": {
                "type": "stdio"
            },
            "version": "0.10.4"
        }
    ],
    "repository": {
        "source": "github",
        "url": "https://github.com/RooAGI/Membrick"
    },
    "title": "Membrick",
    "version": "0.10.4",
    "websiteUrl": "https://www.rooagi.com"
}
